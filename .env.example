# Firebase Configuration
# Replace these values with your actual Firebase project settings from the Firebase Console:
# Project Settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopmentPurposeOnly
VITE_FIREBASE_AUTH_DOMAIN=hostelcart-pilot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hostelcart-pilot
VITE_FIREBASE_STORAGE_BUCKET=hostelcart-pilot.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Firebase Emulator Settings (for local development without cloud connection)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_HOST=localhost
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_HOST=localhost
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_FUNCTIONS_HOST=localhost
VITE_EMULATOR_FUNCTIONS_PORT=5001

# App configuration
VITE_APP_NAME=HostelCart
VITE_APP_TAGLINE="Shop Together. Save Together. No Unnecessary Items."

